{
  "name": "artemis-ii-mission-tracker",
  "version": "1.0.0",
  "description": "Interactive 3D simulator for the NASA Artemis II mission",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client && tsx watch src/server.ts",
    "dev:client": "tsc -p tsconfig.client.json --watch",
    "build": "tsc && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "test": "vitest run",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/three": "^0.160.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
